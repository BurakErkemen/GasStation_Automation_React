rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }

    match /shifts/{id}         { allow read, write: if isAuth(); }
    match /marketShifts/{id}   { allow read, write: if isAuth(); }
    match /customers/{id}      { allow read, write: if isAuth(); }
    match /employees/{id}      { allow read, write: if isAuth(); }
    match /invoices/{id}       { allow read, write: if isAuth(); }
    match /payments/{id}       { allow read, write: if isAuth(); }
    match /suppliers/{id}      { allow read, write: if isAuth(); }
    match /cardAgreements/{id} { allow read, write: if isAuth(); }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAuth();
    }
  }
}
